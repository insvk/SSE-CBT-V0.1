{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "builds": [
    {
      "src": "api_app.py",
      "use": "@vercel/python"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api_app.py"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api_app.py"
    },
    {
      "source": "/health",
      "destination": "/api_app.py"
    }
  ]
}

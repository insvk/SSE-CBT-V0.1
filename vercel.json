{
  "version": 2,
  "builds": [
    {
      "src": "api_app.py",
      "use": "@vercel/python"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build"
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api_app.py" },
    { "source": "/health",   "destination": "/api_app.py" }
  ]
}

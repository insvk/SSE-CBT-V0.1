{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "fastapi",
      "env": {
        "SUPABASE_URL": "@supabase_url",
        "SUPABASE_SERVICE_ROLE_KEY": "@supabase_service_role_key",
        "SUPABASE_JWT_SECRET": "@supabase_jwt_secret"
      }
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
